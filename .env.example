# LLM Provider Configuration (used in Phase 5: LangGraph Triage)
# Supported values: groq | gemini
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Path Overrides (defaults resolve relative to project root)
# UNSW_RAW_DIR=data/raw/UNSW_NB15
# CICIDS_RAW_DIR=data/raw/CICIDS2017
# ALERT_DB_PATH=artifacts/alerts.db

# Runtime Settings
LOG_LEVEL=INFO
RANDOM_SEED=42